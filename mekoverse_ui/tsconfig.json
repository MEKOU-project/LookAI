{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,

    /* パス解決の設定（重要） */
    "moduleResolution": "bundler",
    "paths": {
      "@mekou/engine-api": ["node_modules/@mekou/engine-api"]
    },

    /* 厳格すぎるルールを緩和 */
    "verbatimModuleSyntax": false, // これを false にすれば "type" 指定が必須ではなくなります
    "isolatedModules": true,       // Vite (esbuild) 用にこれは true が安全
    
    /* その他 */
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true
  },
  "include": ["src/**/*"]
}